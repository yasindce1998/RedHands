{
  "name": "k8s-recon-chain",
  "description": "Kubernetes offensive recon using KubeDagger: cluster discovery (recording discovered nodes and pods into the target database), service-account token harvesting, RBAC abuse, then a MITRE ATT&CK export of covered techniques.",
  "vars": [
    { "name": "namespace", "description": "Namespace to operate in", "default": "default" }
  ],
  "steps": [
    {
      "id": "discover",
      "tool": "kubedagger_k8s_discover",
      "params": { "namespace": "{{namespace}}" },
      "on_fail": "stop",
      "mitre": ["T1613"],
      "record": [
        { "type": "host", "path": "nodes", "fields": { "ip": "ip", "hostname": "name", "os": "os" } },
        { "type": "host", "path": "pods", "fields": { "ip": "pod_ip", "hostname": "name" } }
      ]
    },
    { "id": "sa_tokens", "tool": "kubedagger_sa_token", "params": { "namespace": "{{namespace}}", "action": "steal" }, "on_fail": "continue", "mitre": ["T1552.001"] },
    { "id": "rbac", "tool": "kubedagger_k8s_abuse", "params": { "action": "enum", "namespace": "{{namespace}}" }, "on_fail": "continue", "mitre": ["T1069.003"] },
    { "id": "mitre", "tool": "kubedagger_mitre_export", "params": { "format": "markdown" }, "on_fail": "continue" },
    { "id": "detections", "tool": "kubedagger_detection", "params": { "action": "generate" }, "on_fail": "continue" }
  ]
}
